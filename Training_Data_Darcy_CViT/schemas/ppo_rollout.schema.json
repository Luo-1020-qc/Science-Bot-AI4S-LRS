{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future fresh on-policy PPO rollout contract; no such data generated here",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "harness_ppo_rollout_v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rollout_batch_id": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "object",
      "properties": {
        "action_mask": {
          "type": "object"
        },
        "budget": {
          "type": "object"
        },
        "draft": {
          "type": [
            "object",
            "null"
          ]
        },
        "evidence": {
          "type": "array"
        },
        "facts": {
          "type": "object"
        },
        "history": {
          "type": "array"
        },
        "job": {
          "type": "object"
        },
        "permissions": {
          "type": "object"
        },
        "unknown": {
          "type": "array"
        },
        "user_messages": {
          "type": "array"
        }
      },
      "required": [
        "action_mask",
        "budget",
        "draft",
        "evidence",
        "facts",
        "history",
        "job",
        "permissions",
        "unknown",
        "user_messages"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "ask",
            "inspect_mock",
            "propose_design",
            "check_design_mock",
            "revise_design",
            "reconcile_job_mock",
            "resume_job_mock",
            "stop_with_evidence",
            "submit_for_review"
          ]
        },
        "arguments": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "behavior_log_probability": {
      "type": "number"
    },
    "value_estimate": {
      "type": "number"
    },
    "next_value_estimate": {
      "type": "number"
    },
    "reward": {
      "type": "number"
    },
    "terminated": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    },
    "on_policy": {
      "const": true
    },
    "mask_version": {
      "type": "string",
      "minLength": 1
    },
    "reward_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "policy_hash",
    "rollout_batch_id",
    "observation",
    "action",
    "behavior_log_probability",
    "value_estimate",
    "next_value_estimate",
    "reward",
    "terminated",
    "truncated",
    "on_policy",
    "mask_version",
    "reward_version"
  ],
  "additionalProperties": false
}
