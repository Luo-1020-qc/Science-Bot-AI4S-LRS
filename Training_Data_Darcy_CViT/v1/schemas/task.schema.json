{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness illustrative task envelope; actor receives initial_observation only",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "harness_examples_v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "root_group": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "darcy",
        "cvit"
      ]
    },
    "policy_split": {
      "enum": [
        "train",
        "development",
        "evaluation_example"
      ]
    },
    "scenario_for_curator_only": {
      "type": "string",
      "minLength": 1
    },
    "data_lineage": {
      "type": "object"
    },
    "initial_observation": {
      "type": "object",
      "properties": {
        "action_mask": {
          "type": "object"
        },
        "budget": {
          "type": "object"
        },
        "draft": {
          "type": [
            "object",
            "null"
          ]
        },
        "evidence": {
          "type": "array"
        },
        "facts": {
          "type": "object"
        },
        "history": {
          "type": "array"
        },
        "job": {
          "type": "object"
        },
        "permissions": {
          "type": "object"
        },
        "unknown": {
          "type": "array"
        },
        "user_messages": {
          "type": "array"
        }
      },
      "required": [
        "action_mask",
        "budget",
        "draft",
        "evidence",
        "facts",
        "history",
        "job",
        "permissions",
        "unknown",
        "user_messages"
      ],
      "additionalProperties": false
    },
    "training_target": {
      "type": "string",
      "minLength": 1
    },
    "expert_status": {
      "const": "pending"
    },
    "origin": {
      "const": "hand_authored_scripted_example"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "root_group",
    "domain",
    "policy_split",
    "scenario_for_curator_only",
    "data_lineage",
    "initial_observation",
    "training_target",
    "expert_status",
    "origin"
  ],
  "additionalProperties": false
}
