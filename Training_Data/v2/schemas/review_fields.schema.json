{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "reviewer",
    "reason",
    "reviewed_at"
  ],
  "additionalProperties": false
}
